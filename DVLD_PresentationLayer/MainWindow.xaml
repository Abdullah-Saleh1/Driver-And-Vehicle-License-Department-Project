<Window x:Class="DVLD_PresentationLayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
        mc:Ignorable="d"
        Title="Driving License And Vehicle Department" 
        Height="700" Width="1200" 
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BrushPrimary}" Loaded="Window_Loaded">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="3" Fill="{StaticResource CircuitPatternBrush}"/>


        <!-- Navbar Container -->
        <Grid Grid.Row="0"
              Margin="100,15,100,10">

            <Border Background="{StaticResource BrushSecondary}"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.06" Color="Black" Direction="270"/>
                </Border.Effect>
            </Border>

            <Grid Margin="15,8">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center">

                    <Image Source="/Images/DVLD Logo.png" Width="40" Height="40" Margin="0,0,10,0"/>

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="btnApplications"
                                Style="{StaticResource ModernTopButtonStyle}"
                                Click="btnApplications_Click">

                            <StackPanel Orientation="Horizontal">

                                <fa:FontAwesome Icon="Solid_FileLines"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Margin="0,0,8,0"
                                 Foreground="{Binding Foreground,
                                 RelativeSource={RelativeSource AncestorType=Button}}"/>

                                <TextBlock Text="Applications"
                   Foreground="{Binding Foreground,
                   RelativeSource={RelativeSource AncestorType=Button}}"/>

                            </StackPanel>

                            <Button.ContextMenu>
                                <ContextMenu>

                                    <MenuItem Header="Driving Licenses Services">
                                        <MenuItem Header="New Driving License">
                                            <MenuItem Header="Local License"/>
                                            <MenuItem Header="International License"/>
                                        </MenuItem>

                                        <MenuItem Header="Renew Driving License"/>
                                        <MenuItem Header="Replace for Lost or Damaged"/>
                                        <MenuItem Header="Release Detained License"/>
                                        <MenuItem Header="Retake Test"/>
                                    </MenuItem>

                                    <MenuItem Header="Manage Applications">
                                        <MenuItem Header="Local Driving License Applications"/>
                                        <MenuItem Header="International Driving License Applications"/>
                                    </MenuItem>

                                    <MenuItem Header="Detained Licenses">
                                        <MenuItem Header="Manage Detained Licenses"/>
                                        <MenuItem Header="Detained License"/>
                                        <MenuItem Header="Release Detained License"/>
                                    </MenuItem>

                                    <MenuItem Header="Manage Application Types" x:Name="btnManageApplicationTypes" Click="btnManageApplicationTypes_Click"/>
                                    <MenuItem Header="Manage Test Types"/>

                                </ContextMenu>
                            </Button.ContextMenu>

                        </Button>

                    </StackPanel>

                    <Button x:Name="btnPeople"
                            Style="{StaticResource ModernTopButtonStyle}" Click="btnPeople_Click">

                        <StackPanel Orientation="Horizontal">

                            <fa:FontAwesome Icon="Solid_Users"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Margin="0,0,8,0"
                                 Foreground="{Binding Foreground,
                                 RelativeSource={RelativeSource AncestorType=Button}}"/>

                            <TextBlock Text="People"
                   Foreground="{Binding Foreground,
                   RelativeSource={RelativeSource AncestorType=Button}}"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnDrivers"
                            Style="{StaticResource ModernTopButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <fa:FontAwesome Icon="Solid_Car"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Margin="0,0,8,0"
                                 Foreground="{Binding Foreground,
                                 RelativeSource={RelativeSource AncestorType=Button}}"/>

                            <TextBlock Text="Drivers"
                   Foreground="{Binding Foreground,
                   RelativeSource={RelativeSource AncestorType=Button}}"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnUsers"
                            Style="{StaticResource ModernTopButtonStyle}" Click="btnUsers_Click">

                        <StackPanel Orientation="Horizontal">

                            <fa:FontAwesome Icon="Solid_User"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Margin="0,0,8,0"
                                 Foreground="{Binding Foreground,
                                 RelativeSource={RelativeSource AncestorType=Button}}"/>

                            <TextBlock Text="Users"
                   Foreground="{Binding Foreground,
                   RelativeSource={RelativeSource AncestorType=Button}}"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="btnAccountSettings"
                            Style="{StaticResource ModernTopButtonStyle}" Click="btnAccountSettings_Click">

                        <StackPanel Orientation="Horizontal">

                            <fa:FontAwesome Icon="Solid_Gear"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Margin="0,0,8,0"
                                 Foreground="{Binding Foreground,
                                 RelativeSource={RelativeSource AncestorType=Button}}"/>

                            <TextBlock Text="Settings"
                   Foreground="{Binding Foreground,
                   RelativeSource={RelativeSource AncestorType=Button}}"/>

                        </StackPanel>

                        <Button.ContextMenu>
                            <ContextMenu>
                                
                                <MenuItem x:Name="btnCurrentUserInfo" Header="Current User Info" Click="btnCurrentUserInfo_Click"/>
                                <MenuItem x:Name="btnChangePassword" Header="Change Password" Click="btnChangePassword_Click"/>
                                <MenuItem x:Name="btnSignOut" Header="Sign Out" Click="btnSignOut_Click"/>

                            </ContextMenu>
                        </Button.ContextMenu>

                    </Button>

                </StackPanel>

            </Grid>

        </Grid>


        <!-- Main Content -->

        <Grid Grid.Row="1" Margin="100, 0, 100, 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Label Style="{StaticResource MainLbl}" Content="Driving License" Margin="0, 0, 0, -20"></Label>
                    <Label Style="{StaticResource MainLbl}" Foreground="{StaticResource BrushAccent}" Margin="0, 0, 0, -20" Content="&amp; Vehicle"></Label>
                    <Label Style="{StaticResource MainLbl}" Content="Department"></Label>
                    <!--<TextBlock Foreground="{StaticResource BrushTextMuted}" MaxWidth="600" Margin="0,20,0,0" FontSize="16" TextWrapping="Wrap">We built this platform to save your time and effort. Now you can easily track license</TextBlock>-->

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0, 30, 0, 30" >
                        

                        <Button Style="{StaticResource Btn}" 
                            Height="45"
                            FontSize="18"
                            Cursor="Hand">

                            <StackPanel Orientation="Horizontal">

                                <fa:FontAwesome Icon="Solid_CirclePlus"
                                     Foreground="{StaticResource BrushPrimary}"
                                     FontSize="20"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>

                                <TextBlock Text="Create New License"
                                    VerticalAlignment="Center">
                                </TextBlock>

                            </StackPanel>

                        </Button>

                    </StackPanel>
                </StackPanel>

                <Image Grid.Column="1" Source="/Images/landing license.png" Margin="0, 0, 0, 40"  HorizontalAlignment="Center" Width="500">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.15" Color="Black" Direction="270"/>
                    </Image.Effect>
                </Image>
            </Grid>
        </Grid>

        <!-- Footer / Quick Stats Bar -->
        <Border Grid.Row="2" 
        Margin="100,0,100,25" 
        Background="{StaticResource BrushSecondary}" 
        CornerRadius="16"
        Padding="30,26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.06" Color="Black" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Stat 1: Total Drivers -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="13" Background="#1A006C35" Margin="0,0,14,0">
                        <fa:FontAwesome Icon="Solid_IdCard" FontSize="20" Foreground="{StaticResource BrushAccent}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblTotalDrivers" Text="1,248" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}"/>
                        <TextBlock Text="Total Drivers" FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="36" Fill="{StaticResource BrushComponents}"/>

                <!-- Stat 2: Active Licenses -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="13" Background="#1A16A34A" Margin="0,0,14,0">
                        <fa:FontAwesome Icon="Solid_CircleCheck" FontSize="20" Foreground="{StaticResource BrushSuccess}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblActiveLicenses" Text="856" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}"/>
                        <TextBlock Text="Active Licenses" FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="3" Width="1" Height="36" Fill="{StaticResource BrushComponents}"/>

                <!-- Stat 3: Pending Applications -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="13" Background="#1AF59E0B" Margin="0,0,14,0">
                        <fa:FontAwesome Icon="Solid_Clock" FontSize="20" Foreground="{StaticResource BrushWarning}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" >
                        <TextBlock x:Name="lblPendingApps" Text="42" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}"/>
                        <TextBlock Text="Pending Apps" FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="5" Width="1" Height="36" Fill="{StaticResource BrushComponents}"/>

                <!-- Stat 4: Detained Licenses -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="13" Background="#1ADC2626" Margin="0,0,14,0">
                        <fa:FontAwesome Icon="Solid_TriangleExclamation" FontSize="20" Foreground="{StaticResource BrushDanger}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblDetainedLicenses" Text="15" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextMain}"/>
                        <TextBlock Text="Detained Licenses" FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>