<Window x:Class="DVLD_PresentationLayer.Licenses.winShowPersonLicenseHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_PresentationLayer.Licenses.Controls"
        xmlns:uc="clr-namespace:DVLD_PresentationLayer.People.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="winShowPersonLicenseHistory" Height="670" Width="960" Loaded="Window_Loaded">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <Label Content="License History" VerticalAlignment="Center" Style="{StaticResource TitleLabelStyle}"/>

        <uc:ctrlPersonCardWithFilter x:Name="ctrlPersonCardWithFilter1" Grid.Row="1"/>

        <local:ctrlDriverLicenses Margin="10" x:Name="ctrlDriverLicenses1" Grid.Row="2"/>

    </Grid>
</Window>
