<UserControl x:Class="DVLD_PresentationLayer.Licenses.Controls.ctrlDriverLicenses"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_PresentationLayer.Licenses.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="250" Width="Auto">
    <Grid>

        <TabControl x:Name="tcDriverLicenses" Style="{StaticResource ModernTabControl}">
            <TabItem Header="Local" x:Name="tabLocalLicenses">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Margin="10" x:Name="dgDriverLocalLicenses" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="True">
                        <!-- Context Menu for Local Licenses -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="btnShowLocalLicenseInfo" Header="Show License Info" Click="btnShowLocalLicenseInfo_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1">
                        <Label Content="Records: " Margin="10,0,0,6" Style="{StaticResource lblStyle}"/>
                        <Label x:Name="lblLocalRecordsCount" Content="0" Style="{StaticResource lblStyle}" Margin="0,0,0,6"/>
                    </StackPanel>
                </Grid>

            </TabItem>

            <TabItem Header="International" x:Name="tabInternationalLicenses">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Margin="10" x:Name="dgDriverInternationalLicenses" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="True">
                        <!-- Context Menu for International Licenses -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="btnShowInternationalLicenseInfo" Header="Show License Info" Click="btnShowInternationalLicenseInfo_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1">
                        <Label Content="Records: " Margin="10,0,0,6" Style="{StaticResource lblStyle}"/>
                        <Label x:Name="lblInternationalRecordsCount" Content="0" Style="{StaticResource lblStyle}" Margin="0,0,0,6"/>
                    </StackPanel>
                </Grid>

            </TabItem>

        </TabControl>

    </Grid>
</UserControl>
