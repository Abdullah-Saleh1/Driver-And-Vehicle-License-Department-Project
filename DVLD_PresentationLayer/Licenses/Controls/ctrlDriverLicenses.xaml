<UserControl x:Class="DVLD_PresentationLayer.Licenses.Controls.ctrlDriverLicenses"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_PresentationLayer.Licenses.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="250" Width="Auto">
    <Grid>

        <Label Content="test"/>

        <TabControl Grid.Row="1" x:Name="tcDriverLicenses">
            <TabItem Header="Local" FontWeight="Bold" FontSize="14" x:Name="tabLocalLicenses" Padding="5">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <DataGrid Margin="10" x:Name="dgDriverLocalLicenses" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="True" Height="100">
                        <!-- Context Menu for Local Licenses -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="btnShowLocalLicenseInfo" Header="Show License Info" Click="btnShowLocalLicenseInfo_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1">
                        <Label Content="Records: " Margin="10, 10, 0, 10" Style="{StaticResource lblStyle}"/>
                        <Label x:Name="lblLocalRecordsCount" Content="0" Style="{StaticResource lblStyle}" Margin="0, 10, 0, 10"/>
                    </StackPanel>
                </Grid>

            </TabItem>

            <TabItem Header="International" FontWeight="Bold" FontSize="14" x:Name="tabInternationalLicenses">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <DataGrid Margin="10" x:Name="dgDriverInternationalLicenses" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="True" Height="100">
                        <!-- Context Menu for International Licenses -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="btnShowInternationalLicenseInfo" Header="Show License Info" Click="btnShowInternationalLicenseInfo_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Grid.Row="1">
                        <Label Content="Records: " Margin="10, 10, 0, 10" Style="{StaticResource lblStyle}"/>
                        <Label x:Name="lblInternationalRecordsCount" Content="0" Style="{StaticResource lblStyle}" Margin="0, 10, 0, 10"/>
                    </StackPanel>
                </Grid>

            </TabItem>

        </TabControl>

    </Grid>
</UserControl>
