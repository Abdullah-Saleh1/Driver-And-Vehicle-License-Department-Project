<Window x:Class="DVLD_PresentationLayer.Licenses.LocalLicenses.winIssueLicenseFirstTime"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_PresentationLayer.Licenses.LocalLicenses"
        xmlns:uc="clr-namespace:DVLD_PresentationLayer.Applications.Controls"
        mc:Ignorable="d"
        
        WindowStartupLocation="CenterScreen"
        Title="winIssueLicenseFirstTime" Height="580" Width="800" Loaded="Window_Loaded">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <uc:ctrlLocalDrivinLicenseApplicationInfo x:Name="ctrlLocalDrivingLicenseApplicationInfo1"/>

        <Grid Grid.Row="1" Margin="50,0, 50, 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Notes:" Style="{StaticResource lblStyle}" Grid.Column="0" />

            <TextBox x:Name="txtNotes" Grid.Column="1"
             FontSize="14" Padding="4" Height="Auto" Margin="0,10,0,0"
             TextWrapping="Wrap"
             AcceptsReturn="True" 
             VerticalScrollBarVisibility="Auto"
             HorizontalAlignment="Stretch"/>
        </Grid>


        <StackPanel  Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnClose" Content="Close" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Margin="0, 0, 10, 0" Click="CloseWindow" IsCancel="True"/>
            <Button x:Name="btnIssue" Content="Issue" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Margin="0"  IsDefault="True" Click="btnIssue_Click"/>
        </StackPanel>

    </Grid>
</Window>
