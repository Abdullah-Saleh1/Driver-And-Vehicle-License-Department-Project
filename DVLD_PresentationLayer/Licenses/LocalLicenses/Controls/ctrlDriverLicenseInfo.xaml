<UserControl x:Class="DVLD_PresentationLayer.Licenses.LocalLicenses.Controls.ctrlDriverLicenseInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_PresentationLayer.Licenses.LocalLicenses.Controls"
             mc:Ignorable="d" 
             Width="800" Height="Auto">
    <Border Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Rectangle Grid.ColumnSpan="3" Fill="{StaticResource CircuitPatternBrush}"/>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Class: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblClass" Style="{StaticResource lblStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Name: " Style="{StaticResource lblStyle}"/>
                    <Label Style="{StaticResource lblStyle}" x:Name="lblName"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="National No: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblNational" Style="{StaticResource lblStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Gender: " Style="{StaticResource lblStyle}"/>
                    <Label Style="{StaticResource lblStyle}" x:Name="lblGender"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" >
                    <Label Content="Issue Date: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblIssueDate" Style="{StaticResource lblStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Issue Reason: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblIssueReason" Style="{StaticResource lblStyle}"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <Label Content="Notes: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblNotes" Style="{StaticResource lblStyle}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">

                <StackPanel Orientation="Horizontal">
                    <Label Content="IsActive: " Style="{StaticResource lblStyle}"/>
                    <Label  Style="{StaticResource lblStyle}" x:Name="lblIsActive"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Date of Birth: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblDateOfBirth" Style="{StaticResource lblStyle}"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal">
                    <Label Content="Driver ID: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblDriverID" Style="{StaticResource lblStyle}"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal">
                    <Label Content="Expiration Date: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblExpirationDate" Style="{StaticResource lblStyle}"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal">
                    <Label Content="Is Detained: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblIsDetained" Style="{StaticResource lblStyle}"/>
                </StackPanel>


            </StackPanel>

            <Image Grid.Column="2" x:Name="imgPerson" Source="/Images/Male 512.png" Width="210" Height="210" Stretch="Fill"></Image>


        </Grid>



    </Border>
</UserControl>
