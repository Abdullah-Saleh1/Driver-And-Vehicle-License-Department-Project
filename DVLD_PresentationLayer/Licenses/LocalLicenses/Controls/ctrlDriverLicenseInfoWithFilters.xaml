<UserControl x:Class="DVLD_PresentationLayer.Licenses.LocalLicenses.Controls.ctrlDriverLicenseInfoWithFilters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_PresentationLayer.Licenses.LocalLicenses.Controls"
             xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
             mc:Ignorable="d" 
             Width="780" Height="Auto" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle Fill="{StaticResource CircuitPatternBrush}"/>


        <local:ctrlDriverLicenseInfo x:Name="ctrlDriverLicenseInfo1" Grid.Row="1"/>


        <StackPanel x:Name="spFilters" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="License ID: " Style="{StaticResource lblStyle}" Margin="10, 0, 10, 0"/>

            <TextBox Tag="Filter Value" Width="200" Style="{StaticResource ModernTextBox}" x:Name="txtFilterValue" Margin="10, 0, 10, 0" PreviewTextInput="txtFilterValue_PreviewTextInput"/>

            <Button x:Name="btnSearch" VerticalAlignment="Center" Style="{StaticResource Btn}" Click="btnSearch_Click" IsDefault="True">
                <fa:FontAwesome Icon="Solid_MagnifyingGlass"
                    FontSize="20"
                    Foreground="White"
                    />
            </Button>


        </StackPanel>

    </Grid>
</UserControl>
