<Window x:Class="DVLD_PresentationLayer.Applications.LocalApplications.winAddUpdateLocalDrivingLilcenseApplication"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_PresentationLayer.Applications.LocalApplications"
        xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
        mc:Ignorable="d"
                WindowStartupLocation="CenterScreen"
        
        xmlns:uc="clr-namespace:DVLD_PresentationLayer.People.Controls"
        
        Title="New Local Driving License Application" Height="670" Width="820" Loaded="Window_Loaded">
    
    
    <!--
    
    // Presentation Layer
    - On this window Load we Should Get Values for Application Info:  
    Application Date => DateTime.Now ✅
    License Class => Request the database to get license Class Names ✅
    (Here Show ClassName and SelectedPath LicenseClassID) grab the code from winAddEidtPerson ✅
    Application Fees => Request the database to get the current LocalDrivingLicenseApplication Fees ✅
    Create By => LoggedIn User ✅
    
    - When Click To Save
    1. First we check if the person is a valid for this LicenseClass Like Age
    2. Prevent The Application If the Person Has an Application with the same LicenseClass(Unless if the old Application is Cancelled)
    if the old applicaiton is completed also prevent him because we can't add another application for the same LicenseClass
    
    if the person has an Application Already show this error Message
    MessageBox.Show(
    $"Choose another License Class, the selected Person Already have an active application for the selected class with id={ApplicationID}", 
    "Error", 
    MessageBoxButton.OK, 
    MessageBoxImage.Error); 
    
    3. if the person is valid now we should add records in 2 Tables: 
    - Application Table ✅
    - LocalDrivingLicenseApplications (D.L.ApplicaitonID, ApplicationID, LicenseClassID) ✅
    then show D.L.ApplicationID ✅
    
    and the last thing when you should Invoke the Event To Refresh the DataGrid in case this window ✅
    is opened from winManageLocalDrivingLicensesApplication ✅
    
    
    // Data Access Layer
    Make clsApplicationData ✅
    Maek clsLocalDrivingLicenseApplication Data ✅
    
    // BuisinessLayer ✅
    Make clsApplication ✅
    Make clsLocalDrivingLicenseApplication ✅
    
    - in clsLocalDrivingLicenseApplication put ✅
    LocalDrivingLicenseApplicationID ✅
    LicenseClassID ✅
    ApplicationID ✅
    clsApplication ApplicationInfo (Composition) ✅
    And Apply Add/Edit ✅
    
    
    - Manage Local Driving Licenses Applicaiton Window ✅
    1. when work with Data Access and BLL Make enum for ApplicationStatus in clsApplication ✅
    2. Here you will Show ✅
    L.D.L.AppID, DrivingClassName ✅

    
    -->
    
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="3" Fill="{StaticResource CircuitPatternBrush}"/>

        <Label Content="New Local Driving License Application" x:Name="txtTitle" Style="{StaticResource TitleLabelStyle}"/>

        <TabControl Grid.Row="1" x:Name="tcApplicationTabs">
            <TabItem Header="Personal Info" Padding="5">

                <StackPanel>
                    <uc:ctrlPersonCardWithFilter x:Name="ctrlPersonCardWithFilter1"/>

                    <Button x:Name="btnNext"
                        Click="btnNext_Click"
                        Style="{StaticResource Btn}"
                        Content="Next"
                        Width="70"
                        Margin="0, 0, 10, 10"
                        HorizontalAlignment="Right"/>
                </StackPanel>
            </TabItem>
            
            <TabItem Header="Application Info" x:Name="tabApplicationInfo" IsEnabled="False">
                <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- D.L. Application ID -->
                    <TextBlock Text="D.L.Application ID:" Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="14" Margin="5" VerticalAlignment="Center"/>
                    <fa:FontAwesome Icon="Solid_Hashtag" Grid.Row="0" Grid.Column="1" FontSize="16" Foreground="{StaticResource BrushAccent}" Margin="10,5" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblApplicationID" Grid.Row="0" Grid.Column="2" FontWeight="Bold" FontSize="14" Margin="5" VerticalAlignment="Center"/>

                    <!-- Application Date -->
                    <TextBlock Text="Application Date:" Grid.Row="1" Grid.Column="0" FontWeight="Bold" FontSize="14" Margin="5" VerticalAlignment="Center"/>
                    <fa:FontAwesome Icon="Solid_CalendarDays" Grid.Row="1" Grid.Column="1" FontSize="16" Foreground="{StaticResource BrushAccent}" Margin="10,5" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblApplicationDate" FontWeight="Bold" Grid.Row="1" Grid.Column="2" FontSize="14" Margin="5" VerticalAlignment="Center"/>

                    <!-- License Class -->
                    <TextBlock Text="License Class:" Grid.Row="2" Grid.Column="0" FontWeight="Bold" FontSize="14" Margin="5" VerticalAlignment="Center"/>
                        <fa:FontAwesome Icon="Solid_IdCard" Grid.Row="2" Grid.Column="1" FontSize="16" Foreground="{StaticResource BrushAccent}" Margin="10,5" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cbLicenseClasses" Style="{StaticResource ModernComboBoxStyle}" Grid.Row="2" Grid.Column="2" Width="250" Margin="5" VerticalAlignment="Center"/>

                    <!-- Application Fees -->
                    <TextBlock Text="Application Fees:" Grid.Row="3" Grid.Column="0" FontWeight="Bold" FontSize="14" Margin="5" VerticalAlignment="Center"/>
                            <fa:FontAwesome Icon="Solid_MoneyBill" Grid.Row="3" Grid.Column="1" FontSize="16" Foreground="{StaticResource BrushAccent}" Margin="10,5" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblApplicationFees" FontWeight="Bold" Grid.Row="3" Grid.Column="2" FontSize="14" Margin="5" VerticalAlignment="Center"/>

                    <!-- Created By -->
                    <TextBlock Text="Created By:" Grid.Row="4" Grid.Column="0" FontWeight="Bold" FontSize="14" Margin="5" VerticalAlignment="Center"/>
                            <fa:FontAwesome Icon="Solid_User" Grid.Row="4" Grid.Column="1" FontSize="16" Foreground="{StaticResource BrushAccent}" Margin="10,5" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblCreatedBy" Grid.Row="4" Grid.Column="2" FontWeight="Bold" FontSize="14" Margin="5" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnClose" Content="Close" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Margin="0, 0, 10, 0" Click="CloseWindow" IsCancel="True"/>
            <Button x:Name="btnSave" Content="Save" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Margin="0" Click="Save" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
