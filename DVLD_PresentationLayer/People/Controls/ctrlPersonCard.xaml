<UserControl x:Class="DVLD_PresentationLayer.People.Controls.ctrlPersonCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DVLD_PresentationLayer.People.Controls"
             mc:Ignorable="d" 
             Width="800" Height="Auto">

    <Border Background="White" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Rectangle Grid.ColumnSpan="3" Fill="{StaticResource CircuitPatternBrush}"/>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="PersonID: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblPersonID" Style="{StaticResource lblStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Name: " Style="{StaticResource lblStyle}"/>
                    <Label Content="" Style="{StaticResource lblStyle}" x:Name="lblName"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="National: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblNational" Style="{StaticResource lblStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Gender: " Style="{StaticResource lblStyle}"/>
                    <Label Content="" Style="{StaticResource lblStyle}" x:Name="lblGender"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Email: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblEmail" Style="{StaticResource lblStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Address: " Style="{StaticResource lblStyle}"/>
                    <Label Content="" Style="{StaticResource lblStyle}" x:Name="lblAddress"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Date of Birth: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblDateOfBirth" Style="{StaticResource lblStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Phone: " Style="{StaticResource lblStyle}"/>
                    <Label Content="" Style="{StaticResource lblStyle}" x:Name="lblPhone"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Country: " Style="{StaticResource lblStyle}"/>
                    <Label x:Name="lblCountry" Style="{StaticResource lblStyle}"/>
                </StackPanel>
            </StackPanel>


            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Width="Auto" HorizontalAlignment="Center" Style="{StaticResource Btn}" Click="EditPerson">Edit Person Info</Button>

                <Image x:Name="imgPerson" Source="/Images/Male 512.png" Visibility="Collapsed"/>

                <Viewbox Grid.Row="1" Margin="8,6,8,0" StretchDirection="DownOnly"
                         HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border Width="210" Height="210" Style="{StaticResource PersonPhotoFrame}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Source, ElementName=imgPerson}"
                                        Stretch="Uniform"/>
                        </Border.Background>
                    </Border>
                </Viewbox>
            </Grid>

        </Grid>
        
    
        
    </Border>
</UserControl>
