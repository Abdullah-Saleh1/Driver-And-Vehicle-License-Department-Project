<Window x:Class="DVLD_PresentationLayer.Tests.winTakeTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_PresentationLayer.Tests.Controls"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="winScheduleTest" Height="600" Width="500" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="489*"/>
            <ColumnDefinition Width="11*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <local:ctrlScheduledTest x:Name="ctrlScheduledTest1"/>

        <Grid Grid.Row="1" Margin="30, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <Label Content="Result: " Style="{StaticResource lblStyle}" />
            <StackPanel x:Name="stPassFail" Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <RadioButton x:Name="rbPass" IsChecked="True" Content="Pass" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <RadioButton x:Name="rbFail" Content="Fail" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>

            <Label Content="Already Taken" x:Name="lblUserMessage" Visibility="Collapsed" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource lblStyle}" Foreground="Red"/>


            <Label Content="Notes: " Grid.Row="1" VerticalAlignment="Top" Style="{StaticResource lblStyle}"/>

            <TextBox x:Name="txtNotes" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                 FontSize="14" Padding="4" Height="Auto" Margin="0,10,0,0"
                 TextWrapping="Wrap"
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"/>


        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnClose" Content="Close" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Margin="0, 0, 10, 0" Click="CloseWindow" IsCancel="True"/>
            <Button x:Name="btnSave" Content="Save" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Margin="0" Click="Save" IsDefault="True"/>
        </StackPanel>
        
        
    </Grid>
</Window>
