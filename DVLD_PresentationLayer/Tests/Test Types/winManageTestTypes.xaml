<Window x:Class="DVLD_PresentationLayer.Tests.Test_Types.winManageTestTypes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_PresentationLayer.Tests.Test_Types"
        mc:Ignorable="d"
        Title="winManageTestTypes" Height="500" Width="600" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Label Content="Manage Test Types" Style="{StaticResource TitleLabelStyle}"/>


        <DataGrid Grid.Row="1" ColumnWidth="*" x:Name="dgTestTypes" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="True">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="btnEditTestType" Header="Edit Test Type" Click="EditTestType"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" >Records:</Label>
            <Label VerticalAlignment="Center" HorizontalAlignment="Right" x:Name="lblRecordsCount" FontSize="14">5</Label>
            <Button x:Name="btnClose" Grid.Column="2" Content="Close" Width="70" Click="btnClose_Click" Style="{StaticResource Btn}" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Center" IsCancel="True"/>
        </Grid>

    </Grid>
</Window>
