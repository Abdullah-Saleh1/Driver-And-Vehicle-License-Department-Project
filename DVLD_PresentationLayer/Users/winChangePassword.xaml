<Window x:Class="DVLD_PresentationLayer.Users.winChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DVLD_PresentationLayer.Users.Controls"
        mc:Ignorable="d"
        
        xmlns:uc="clr-namespace:DVLD_PresentationLayer.People.Controls"
        
        Title="Change Password" Height="550" Width="800" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="3" Fill="{StaticResource CircuitPatternBrush}"/>



        <local:ctrlUserCard  x:Name="ctrlUserCard1"/>



        <Grid  Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <Label Content="Current Password:" VerticalAlignment="Center" Margin="10" Style="{StaticResource lblStyle}"/>
                <Label Content="New Password:" VerticalAlignment="Center" Margin="10" Style="{StaticResource lblStyle}"/>
                <Label Content="Confirm Password:" VerticalAlignment="Center" Margin="10" Style="{StaticResource lblStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                <PasswordBox x:Name="txtCurrentPassword" Tag="Current Password" Width="200" Height="30" Margin="10" Style="{StaticResource ModernPasswordBox}" PasswordChanged="txtPassword_PasswordChanged" PreviewLostKeyboardFocus="txtCurrentPassword_PreviewLostKeyboardFocus"/>
                <PasswordBox x:Name="txtNewPassword" Tag="New Password" Width="200" Height="30" Margin="10" Style="{StaticResource ModernPasswordBox}" PasswordChanged="txtPassword_PasswordChanged"/>
                <PasswordBox x:Name="txtConfirmPassword" Tag="Confirm Password" Width="200" Height="30" Style="{StaticResource ModernPasswordBox}" PasswordChanged="txtPassword_PasswordChanged"/>
            </StackPanel>
        </Grid>


        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnClose" Content="Close" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Margin="0, 0, 10, 0" Click="CloseWindow" IsCancel="True"/>
            <Button x:Name="btnSave" Content="Save" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Margin="0" Click="SavePerson" IsDefault="True"/>
        </StackPanel>

    </Grid>
</Window>
